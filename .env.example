# ElevenLabs. Required for audio. Never returned by the settings API.
ELEVEN_KEY=
ELEVEN_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVEN_MODEL_ID=eleven_multilingual_v2
BEAT_PADDING_SECONDS=0.15
CHECKPOINT_PAUSE_SECONDS=2.0
ELEVEN_CONCURRENCY=1
OUTPUT_DIR=output

# Django sends this token on PUT /v1/settings. Leave it empty to refuse remote updates.
SETTINGS_FILE=config/overrides.json
SETTINGS_TOKEN=

# Set AI_PROVIDER to one of the model lines below:
# AI_GEMINI_MODEL, AI_DEEPSEEK_MODEL, or AI_OPENAI_MODEL.
# Fill in the API key for that line. The other keys can stay empty.
# A provider, model, or prompt saved from Django admin replaces this choice.
# The keys stay here either way. Admin does not receive or store them.
AI_PROVIDER=AI_GEMINI_MODEL
AI_GEMINI_MODEL=gemini-2.5-flash
AI_DEEPSEEK_MODEL=deepseek-chat
AI_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Same PostgreSQL database as the academy. The studio creates its own studiolesson table.
# Use DATABASE_URL, or the DB_* fields. The studio does not read the academy user table.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Checked on each lesson request. The studio stores the user id from this token.
FIREBASE_PROJECT_ID=

# Browsers allowed to call the studio. Comma-separated.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://sbtyacademy.com,https://www.sbtyacademy.com,https://sbtyacedemy.com,https://www.sbtyacedemy.com

# Script generation. Leave CLOUD_TASKS_QUEUE empty to write the beats in the same request.
# When the queue is set, the request returns immediately and Cloud Tasks calls the target URL.
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_TASKS_OIDC_AUDIENCE=
CLOUD_TASKS_MAX_ATTEMPTS=3
CLOUD_TASKS_DISPATCH_DEADLINE_SECONDS=1200

# Pictures and spoken audio. Leave CLOUD_TASKS_RENDER_QUEUE empty to build the lesson page in the same request.
# This queue is separate from CLOUD_TASKS_QUEUE. The script queue only writes the lines.
# Project, location, service account, attempts, and deadline are shared with the script queue.
CLOUD_TASKS_RENDER_QUEUE=
CLOUD_TASKS_RENDER_TARGET_URL=

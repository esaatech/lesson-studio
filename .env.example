# ElevenLabs. Required for audio. Never returned by the settings API.
ELEVEN_KEY=
ELEVEN_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVEN_MODEL_ID=eleven_multilingual_v2
BEAT_PADDING_SECONDS=0.15
CHECKPOINT_PAUSE_SECONDS=2.0
ELEVEN_CONCURRENCY=1
OUTPUT_DIR=output

# Django sends this token on PUT /v1/settings. Leave it empty to refuse remote updates.
SETTINGS_FILE=config/overrides.json
SETTINGS_TOKEN=

# Set AI_PROVIDER to one of the model lines below:
# AI_GEMINI_MODEL, AI_DEEPSEEK_MODEL, or AI_OPENAI_MODEL.
# Fill in the API key for that line. The other keys can stay empty.
# A provider, model, or prompt saved from Django admin replaces this choice.
# The keys stay here either way. Admin does not receive or store them.
AI_PROVIDER=AI_GEMINI_MODEL
AI_GEMINI_MODEL=gemini-2.5-flash
AI_DEEPSEEK_MODEL=deepseek-chat
AI_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Same PostgreSQL database as the academy. The studio creates its own studiolesson table.
# Use DATABASE_URL, or the DB_* fields. The studio does not read the academy user table.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=

# Checked on each lesson request. The studio stores the user id from this token.
FIREBASE_PROJECT_ID=
